# --- Docker infrastructure (read by docker compose) ---
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend (FastAPI / uvicorn) ---
DATABASE_URL=postgresql://ats:ats@localhost:5432/ats
REDIS_URL=redis://localhost:6379/0

# Only needed if tesseract is not on PATH (typically Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
