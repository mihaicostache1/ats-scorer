# --- Docker infrastructure (read by docker compose) ---
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend (FastAPI / uvicorn) ---
DATABASE_URL=postgresql://ats:ats@localhost:5432/ats
REDIS_URL=redis://localhost:6379/0
# B-15 invitations: the frontend form reads #token= and calls POST /api/v1/auth/accept-invite.
INVITE_ACCEPT_URL=http://localhost:3000/accept-invite
USER_INVITE_EXPIRE_HOURS=48
# Where uploaded CVs are kept in development. Never point this at a publicly served folder.
STORAGE_LOCAL_DIR=storage

# Optional local L-6 model for the embedding worker and make backfill-embeddings.
# ATS_EMBEDDING_MODEL_DIR=/absolute/path/to/ml/models/multilingual-e5-small
# For the Compose worker, enable the embedding image and pass the mounted model path.
# ATS_WORKER_BUILD_TARGET=embedding-worker
# ATS_WORKER_EMBEDDING_MODEL_DIR=/models/multilingual-e5-small

# Only needed if tesseract is not on PATH (typically Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
